    "pg": "^8.16.0",
    "pg-hstore": "^2.3.4",
    "postgres": "^3.4.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-redux": "^9.2.0",
    "react-select": "^5.10.1",
